#!/bin/bash
# morpheus-certificate-install 0.4.2 — test stand-in for the real morpheus-ctl (reconfigure, restart nginx|morpheus-ui, status)
[ "$(id -u)" = 0 ] || { echo "morpheus-ctl must run as root"; exit 1; }
case "$1" in
 reconfigure) echo "Starting Chef Client, version 14.x (fake)"; for r in nginx morpheus-ui rabbitmq mysql elasticsearch; do echo "Recipe: morpheus::$r"; sleep 0.4; echo "  * template[/opt/morpheus/conf/$r.conf] action create (up to date)"; done
   grep -q "^nginx\['ssl_certificate'\]" /etc/morpheus/morpheus.rb && f=$(grep "^nginx\['ssl_certificate'\]" /etc/morpheus/morpheus.rb | tail -1 | cut -d"'" -f4) && [ ! -r "$f" ] && { echo "FATAL: $f missing"; exit 1; }
   echo -e "\e[32mChef Client finished, 12/340 resources updated\e[0m"; echo "morpheus Reconfigured!";;
 restart) if [ "$2" = nginx ]; then
     # install-on-vm.sh makes fake nginx the systemd service mci-fake-nginx; without it, start it directly.
     if [ -d /run/systemd/system ] && systemctl cat mci-fake-nginx.service >/dev/null 2>&1; then
       systemctl restart mci-fake-nginx.service; sleep 1; echo "ok: run: nginx: (pid $(systemctl show -p MainPID --value mci-fake-nginx.service)) 1s"
     else
       pkill -f fake-nginx.py; sleep 0.5; setsid nohup python3 /usr/local/bin/fake-nginx.py >/var/log/fake-morpheus/nginx.log 2>&1 < /dev/null & sleep 1; echo "ok: run: nginx: (pid $!) 1s"
     fi
   else echo "ok: run: $2: (pid 999) 1s"; fi;;
 status) echo "run: /opt/morpheus/service/nginx: (pid $(pgrep -f fake-nginx.py|head -1)) 5s"; echo "run: /opt/morpheus/service/morpheus-ui: (pid 999) 5s";;
 *) echo "usage";;
esac
